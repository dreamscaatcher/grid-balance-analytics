# --- ENTSO-E Transparency Platform (free, requires registration) ---
# 1. Register at transparency.entsoe.eu
# 2. Email transparency@entsoe.eu with subject "Restful API access" if the
#    token option isn't already visible under My Account Settings.
# 3. Once approved, generate the token under My Account Settings ->
#    Web API Security Token.
# The entsoe-apy package reads this exact variable name automatically.
ENTSOE_API=your-security-token

# --- Google BigQuery (project already provisioned) ---
GCP_PROJECT_ID=grid-analysis-505021
BQ_LOCATION=EU

# Auth option A (local dev, recommended): run `gcloud auth application-default login`
# Auth option B (CI): point this at a service-account key file
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# --- DWD Open Data ---
# No auth required -- public file server (opendata.dwd.de). No key needed here.
